#!/usr/bin/env bash
set -euo pipefail

# Construction Skills — Setup Script
# Prepares the toolkit's Python environment and makes this checkout load in
# Claude Code as the "construction" plugin. On Windows, run it from Git Bash.
#
# Usage:
#   ./setup                  Python environment + cleanup of pre-plugin installs.
#                            A checkout at ~/.claude/skills/construction (or at a
#                            project's .claude/skills/construction) loads as-is.
#   ./setup --global         Also copy this checkout to ~/.claude/skills/construction
#   ./setup --project        Also copy this checkout to ./.claude/skills/construction
#                            (run from your project directory)
#   ./setup --dev            Link ~/.claude/skills/construction to this checkout
#                            for live editing (macOS/Linux)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILLS_SOURCE="$SCRIPT_DIR/skills"

# --- Parse flags ---
INSTALL_MODE="none"

for arg in "$@"; do
  case $arg in
    --global)  INSTALL_MODE="global" ;;
    --project) INSTALL_MODE="project" ;;
    --dev)     INSTALL_MODE="dev" ;;
    --help|-h)
      echo "Usage: ./setup [--global|--project|--dev]"
      echo ""
      echo "  (no flag)        Python environment only; a checkout in a Claude Code"
      echo "                   skills directory loads as the construction plugin as-is"
      echo "  --global         Copy this checkout to ~/.claude/skills/construction"
      echo "  --project        Copy this checkout to ./.claude/skills/construction"
      echo "  --dev            Link ~/.claude/skills/construction here (macOS/Linux)"
      echo ""
      exit 0
      ;;
    *)
      echo "Unknown option: $arg"
      exit 1
      ;;
  esac
done

# Copy this checkout (without .git) to $1, replacing an earlier toolkit install there.
install_copy() {
  local target="$1"
  if [ -e "$target" ] && [ "$SCRIPT_DIR" -ef "$target" ]; then
    echo "      Already at $target."
    return 0
  fi
  if [ -L "$target" ]; then
    rm "$target"
  elif [ -d "$target" ]; then
    if [ -f "$target/.claude-plugin/plugin.json" ] || [ -f "$target/.claude/skills/CLAUDE.md" ]; then
      echo "      Replacing the existing install at $target..."
      rm -rf "${target:?}"
    else
      echo "      ERROR: $target exists and is not a construction skills install."
      echo "      Move it aside and re-run."
      exit 1
    fi
  fi
  mkdir -p "$target"
  (cd "$SCRIPT_DIR" && tar cf - --exclude=.git .) | (cd "$target" && tar xf -)
  echo "      Copied to $target. Re-run this after updating your checkout."
}

# Pre-plugin versions of this script made each skill discoverable through
# <skills root>/<skill> -> construction/.claude/skills/<skill>. Those links now
# dangle or shadow the plugin's skills. On Windows, where Git Bash's ln -s
# copies, they are full directories: move those aside rather than delete them.
cleanup_old_install() {
  local root="$1" entry name backup=""
  [ -d "$root" ] || return 0
  for entry in "$root"/*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    name="$(basename "$entry")"
    if [ -L "$entry" ]; then
      case "$(readlink "$entry")" in
        construction/.claude/skills/*|*/construction/.claude/skills/*)
          rm "$entry"
          echo "      Removed old skill link: $entry"
          ;;
      esac
    elif [ -d "$SKILLS_SOURCE/$name" ] && [ -f "$entry/SKILL.md" ] &&
         grep -q 'display_name: "construction-' "$entry/agents/openai.yaml" 2>/dev/null; then
      [ -n "$backup" ] || backup="$HOME/.construction-skills/old-skill-copies/$(date +%Y%m%d-%H%M%S)"
      mkdir -p "$backup"
      mv "$entry" "$backup/"
      echo "      Moved old skill copy aside: $entry -> $backup/$name"
    fi
  done
}

echo "=== Construction Skills Setup ==="
echo ""

# --- Step 1: Initialize construction-skills home ---
echo "[1/5] Initializing ~/.construction-skills/..."
mkdir -p "$HOME/.construction-skills/sessions"
mkdir -p "$HOME/.construction-skills/analytics"
chmod +x "$SCRIPT_DIR/bin/"* "$SCRIPT_DIR/dev/"* 2>/dev/null || true

# --- Step 2: Python environment ---
# bin/construction-python creates the venv and installs requirements.txt on
# first use; run it now so setup reports problems up front.
VENV_DIR="$HOME/.construction-skills/venv"
echo "[2/5] Setting up Python environment at $VENV_DIR..."
VENV_PYTHON="$(CONSTRUCTION_SKILLS_NO_BOOTSTRAP=0 "$SCRIPT_DIR/bin/construction-python" -c 'import sys; print(sys.executable)')" || VENV_PYTHON=""
case "$VENV_PYTHON" in
  *.construction-skills*venv*) ;;
  *)
    echo "      ERROR: could not create the Python environment (see messages above)."
    echo "      Install Python 3.10+ and re-run, or see docs/TROUBLESHOOTING.md."
    exit 1
    ;;
esac
echo "      Python: $VENV_PYTHON"
"$SCRIPT_DIR/bin/construction-config" set python_path "$VENV_PYTHON" >/dev/null 2>&1 || true

# --- Step 3: Claude Code plugin ---
echo "[3/5] Registering the Claude Code plugin..."
PLUGIN_DIR="$SCRIPT_DIR"
case "$INSTALL_MODE" in
  global)
    PLUGIN_DIR="$HOME/.claude/skills/construction"
    install_copy "$PLUGIN_DIR"
    ;;
  project)
    if [ "$(pwd)" -ef "$SCRIPT_DIR" ]; then
      echo "      ERROR: run --project from your project directory, e.g.:"
      echo "        cd /path/to/project && \"$SCRIPT_DIR/setup\" --project"
      exit 1
    fi
    PLUGIN_DIR="$(pwd)/.claude/skills/construction"
    install_copy "$PLUGIN_DIR"
    ;;
  dev)
    "$SCRIPT_DIR/dev/link" | sed 's/^/      /'
    # On Windows dev/link only prints the --plugin-dir hint; nothing was linked.
    if [ "$HOME/.claude/skills/construction" -ef "$SCRIPT_DIR" ]; then
      PLUGIN_DIR="$HOME/.claude/skills/construction"
    fi
    ;;
esac

# Keep skill files readable for Claude Code
if [ -d "$PLUGIN_DIR/skills" ]; then
  find "$PLUGIN_DIR/skills" -name "SKILL.md" -exec chmod 644 {} \;
  find "$PLUGIN_DIR/skills" -path "*/references/*" -type f -exec chmod 644 {} \; 2>/dev/null || true
fi

case "$PLUGIN_DIR" in
  "$HOME/.claude/skills/"*) PLUGIN_SCOPE="every project" ;;
  */.claude/skills/*)       PLUGIN_SCOPE="the project at ${PLUGIN_DIR%/.claude/skills/*}" ;;
  *)                        PLUGIN_SCOPE="" ;;
esac
if [ -n "$PLUGIN_SCOPE" ] && [ -e "$PLUGIN_DIR/.claude-plugin/plugin.json" ]; then
  echo "      Claude Code loads $PLUGIN_DIR as the construction plugin for $PLUGIN_SCOPE."
else
  PLUGIN_SCOPE=""
  echo "      This checkout is not in a Claude Code skills directory, so Claude Code won't load it yet."
fi

# --- Step 4: Clean up pre-plugin installs, register other platforms ---
echo "[4/5] Cleaning up pre-plugin installs and detecting other platforms..."
cleanup_old_install "$HOME/.claude/skills"
case "$PLUGIN_DIR" in
  */.claude/skills/*) cleanup_old_install "$(dirname "$PLUGIN_DIR")" ;;
esac

if [ -d "$HOME/.codex" ]; then
  echo "      Codex: detected"
  CODEX_TARGET="$HOME/.codex/skills/construction"
  mkdir -p "$CODEX_TARGET"
  cp -r "$SKILLS_SOURCE"/* "$CODEX_TARGET"/
  echo "      Codex skills registered at $CODEX_TARGET"
fi

if [ -d "$HOME/.kiro" ]; then
  echo "      Kiro: detected"
  KIRO_TARGET="$HOME/.kiro/skills/construction"
  mkdir -p "$KIRO_TARGET"
  cp -r "$SKILLS_SOURCE"/* "$KIRO_TARGET"/
  echo "      Kiro skills registered at $KIRO_TARGET"
fi

# --- Step 5: Verify config ---
echo "[5/5] Verifying configuration..."
if "$SCRIPT_DIR/bin/construction-config" list >/dev/null 2>&1; then
  echo "      Config system: OK ($HOME/.construction-skills/)"
else
  echo "      Config system: WARNING — construction-config not working"
fi
echo "      Version: $(cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo "unknown")"

# --- Summary ---
echo ""
echo "=== Setup complete ==="
echo ""
echo "Skills ($(find "$SKILLS_SOURCE" -mindepth 2 -maxdepth 2 -name SKILL.md | wc -l | tr -d ' ')):"
for skill_dir in "$SKILLS_SOURCE"/*/; do
  [ -f "$skill_dir/SKILL.md" ] && echo "  /construction:$(basename "$skill_dir")"
done
echo ""
if [ -n "$PLUGIN_SCOPE" ]; then
  echo "Start Claude Code in your project (or run /reload-plugins in an open session),"
  echo "then run /construction:project-setup."
else
  echo "To load the plugin, do one of:"
  echo "  - re-run with --global (all projects), or --project from your project directory"
  echo "  - clone the repo to ~/.claude/skills/construction"
  echo "  - install from the marketplace inside Claude Code:"
  echo "      /plugin marketplace add dleerdefi/claude-code-construction"
  echo "      /plugin install construction@construction-skills"
fi
